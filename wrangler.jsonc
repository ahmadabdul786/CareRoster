{
    "$schema": "node_modules/wrangler/config-schema.json",
    "main": ".open-next/worker.js",
    "name": "locum-hero-frontend",
    "compatibility_date": "2024-12-30",
    "compatibility_flags": [
      "nodejs_compat",
      "global_fetch_strictly_public"
    ],
    "assets": {
      "directory": ".open-next/assets",
      "binding": "ASSETS"
    },
    "vars": {
      "NEXT_PUBLIC_SITE_URL": "https://implement-auth-locum-hero-frontend.mrtayyabhanif.workers.dev"
    },
  "r2_buckets": [],
  "env": {
    "staging": {
      "name": "locum-hero-frontend",
      "vars": {
        "NEXT_PUBLIC_SITE_URL": "https://implement-auth-locum-hero-frontend.mrtayyabhanif.workers.dev"
      },
      "r2_buckets": []
    }
  }
  }